---
import { getCollection } from "astro:content";

import HomeEntry from "../components/HomeEntry.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  getPublishedEntries,
  sortByLastVerifiedAndTitle,
} from "../lib/content";
import { noteContextLabel } from "../lib/content-labels.js";
import { getRecentChanges } from "../lib/homepage";
import { siteConfig } from "../site";
import "../styles/home.css";

const [notes, projects] = await Promise.all([
  getCollection("notes"),
  getCollection("projects"),
]);
const changes = getRecentChanges(notes, projects);
const [lead, ...otherChanges] = changes;
const shownPaths = new Set(changes.map((change) => change.href));
const currentNotesById = new Map(
  getPublishedEntries(notes)
    .filter((entry) => entry.data.lifecycle === "current")
    .map((entry) => [entry.id, entry]),
);

// These are durable reading routes, not permanent occupants of the opening.
// A missing or retired reference needs an editorial replacement, not silence.
const readingRoutes = [
  { id: "the-agent-is-not-the-application", label: "Agent systems" },
  {
    id: "a-field-guide-to-assurance-managed-ai-development",
    label: "Software assurance",
  },
  { id: "moving-a-live-cluster-to-a-new-subnet", label: "Infrastructure" },
  { id: "schema-on-split", label: "Data architecture" },
]
  .map((route) => {
    const entry = currentNotesById.get(route.id);
    if (!entry) {
      throw new Error(
        `Homepage reference "${route.id}" is missing, a draft, or not current`,
      );
    }
    return { ...route, entry, href: `/notes/${entry.id}/` };
  })
  .filter((route) => !shownPaths.has(route.href));

const projectRecords = sortByLastVerifiedAndTitle(getPublishedEntries(projects))
  .filter(
    (entry) => entry.data.featured && !shownPaths.has(`/projects/${entry.id}/`),
  )
  .slice(0, 3);
---

<BaseLayout>
  <div class="container home">
    <section class="home-intro" aria-labelledby="home-title">
      <div>
        <p class="eyebrow">{siteConfig.profile.name} · Field notebook</p>
        <h1 id="home-title">{siteConfig.home.heading}</h1>
        <p class="home-description">{siteConfig.home.summary}</p>
      </div>
      <a class="home-explore-link" href="/explore/">
        Find a topic <span aria-hidden="true">↗</span>
      </a>
    </section>

    <section class="home-section home-latest" aria-labelledby="latest-heading">
      <div class="home-section-heading">
        <h2 id="latest-heading">Latest changes</h2>
        <a href="/notes/">All notes <span aria-hidden="true">→</span></a>
      </div>
      {
        lead ? (
          <div class="home-current-grid">
            <HomeEntry change={lead} variant="lead" />
            {otherChanges.length > 0 && (
              <div class="home-recent-list">
                {otherChanges.map((change) => (
                  <HomeEntry change={change} />
                ))}
              </div>
            )}
          </div>
        ) : (
          <p class="empty-state">No published entries yet.</p>
        )
      }
    </section>

    {
      readingRoutes.length > 0 && (
        <section class="home-section" aria-labelledby="references-heading">
          <div class="home-section-heading">
            <h2 id="references-heading">Useful starting points</h2>
          </div>
          <div class="home-reference-grid">
            {readingRoutes.map(({ entry, href, label }) => (
              <article class="home-reference">
                <p class="home-route-label">{label}</p>
                <h3>
                  <a href={href}>{entry.data.title}</a>
                </h3>
                <p class="home-entry-context">{noteContextLabel(entry.data)}</p>
                <p>{entry.data.summary}</p>
              </article>
            ))}
          </div>
        </section>
      )
    }

    {
      projectRecords.length > 0 && (
        <section class="home-section" aria-labelledby="projects-heading">
          <div class="home-section-heading">
            <h2 id="projects-heading">Project records</h2>
            <a href="/projects/">
              All projects <span aria-hidden="true">→</span>
            </a>
          </div>
          <p class="home-section-copy">
            What exists, what was checked, and what remains uncertain.
          </p>
          <div class="home-project-grid">
            {projectRecords.map((entry) => (
              <HomeEntry
                change={{
                  kind: "project",
                  entry,
                  href: `/projects/${entry.id}/`,
                  date: entry.data.lastVerified,
                  dateLabel: "Verified",
                }}
              />
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
