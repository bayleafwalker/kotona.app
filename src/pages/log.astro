---
import { getCollection } from "astro:content";

import BaseLayout from "../layouts/BaseLayout.astro";
import { formatDate } from "../lib/content";
import { getPublicationEvents } from "../lib/content-revisions.ts";
import changelog from "../data/changelog.json";

type ChangelogEntry = {
  date: string;
  entry: string;
  href?: string;
  summary?: string;
};
const generatedEntries = getPublicationEvents(
  await getCollection("notes"),
  await getCollection("projects"),
);
const entries = [...(changelog as ChangelogEntry[]), ...generatedEntries]
  .sort(
    (left, right) =>
      new Date(right.date).getTime() - new Date(left.date).getTime() ||
      left.entry.localeCompare(right.entry),
  )
  .map((item) => ({
    ...item,
    formattedDate: formatDate(new Date(item.date)),
  }));
---

<BaseLayout
  title="Log"
  description="Chronological record of site changes and project state transitions."
>
  <section class="page-intro">
    <p class="eyebrow">Log</p>
    <h1 class="page-title">Publication and project log</h1>
    <p class="page-copy">
      Publications, material revisions and project evidence checks, with what
      changed in the claim or its supporting evidence. Revision summaries
      describe the latest substantive edit; the linked repository retains the
      full history. Site-level changes remain a small manual record.
    </p>
  </section>

  <section class="page-section">
    <ol class="changelog-list" reversed>
      {
        entries.map((item) => (
          <li class="changelog-entry">
            <time class="changelog-date" datetime={item.date}>
              {item.formattedDate}
            </time>
            <span class="changelog-text">
              {item.href ? <a href={item.href}>{item.entry}</a> : item.entry}
              {item.summary && (
                <span class="changelog-summary">{item.summary}</span>
              )}
            </span>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>

<style>
  .changelog-summary {
    display: block;
    margin-top: 0.4rem;
    line-height: 1.55;
    color: var(--muted);
  }
</style>
