---
import { getCollection } from "astro:content";

import KnowledgeMap from "../components/KnowledgeMap.astro";
import { knowledgeClusters } from "../data/knowledge-clusters";
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildKnowledgeGraph } from "../lib/knowledge-map";
import { buildReferenceIndex } from "../lib/reference-index";
import { buildRevision } from "../build";
import { siteConfig } from "../site";

export const prerender = true;

const entries = [
  ...(await getCollection("notes")),
  ...(await getCollection("projects")),
];
const graph = buildKnowledgeGraph(entries, knowledgeClusters);
// The in-page ranker scores the same fields the public catalog publishes, from
// the same projection. It deliberately omits document bodies: a machine client
// retrieves those from the `.md` resources, and shipping the whole corpus to
// every reader would cost far more than the ranking it buys.
const searchDocuments = buildReferenceIndex(entries, {
  baseUrl: Astro.site ?? new URL(siteConfig.siteUrl),
  revision: buildRevision,
}).documents.map((document) => ({
  id: document.id,
  type: document.type,
  path: new URL(document.url).pathname,
  title: document.title,
  summary: document.summary,
  area: document.classification.area,
  role: document.classification.role,
  claimPosture: document.classification.claimPosture,
  lifecycle: document.classification.lifecycle,
  tags: document.classification.tags,
  supersededBy: document.supersededBy?.map((successor) => successor.id),
  discoverFor: document.reference?.discoverFor,
  establishes: document.reference?.establishes,
}));
---

<BaseLayout
  title="Explore"
  description="Explore published notes and projects through a curated map of explicit relationships and editorial clusters."
>
  <section class="page-intro explore-intro">
    <p class="eyebrow">Explore</p>
    <h1 class="page-title">Topics and relationships.</h1>
    <p class="page-copy">
      A curated atlas of published notes and projects. Clusters organize the
      corpus; lines show only relationships explicitly declared in the content.
    </p>
  </section>
  <section class="page-section">
    <KnowledgeMap graph={graph} searchDocuments={searchDocuments} />
  </section>
</BaseLayout>
