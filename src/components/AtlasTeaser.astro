---
import { readSystemsAtlas } from "../lib/read-systems-atlas";

type Props = { compact?: boolean };
const { compact = false } = Astro.props;
const atlas = await readSystemsAtlas();
const regions = atlas.regions.slice(0, 6).map((region, index) => ({
  ...region,
  x: 95 + (index % 3) * 175,
  y: index < 3 ? 46 : 154,
}));
const regionById = new Map(regions.map((region) => [region.id, region]));
const nodeRegions = new Map(atlas.nodes.map((node) => [node.id, node.region]));
const seen = new Set<string>();
const connections = atlas.edges.flatMap((edge) => {
  if (edge.kind === "historical" || edge.state === "historical") return [];
  const from = regionById.get(nodeRegions.get(edge.from) ?? "");
  const to = regionById.get(nodeRegions.get(edge.to) ?? "");
  if (!from || !to || from.id === to.id) return [];
  const key = [from.id, to.id].sort().join(":");
  if (seen.has(key)) return [];
  seen.add(key);
  return [{ from, to, conceptual: edge.kind === "conceptual" }];
});
---

<section
  class:list={["atlas-teaser", { "atlas-teaser-compact": compact }]}
  aria-label="Systems atlas"
  data-atlas-teaser
>
  <div class="atlas-teaser-copy">
    <p class="eyebrow">Systems atlas</p>
    <h2><a href="/map/">A map of the workshop.</a></h2>
    <p>
      Projects, services, interfaces, and the notes behind them. Follow a piece
      of work, a household decision, or an idea that changed.
    </p>
    <a class="atlas-teaser-link" href="/map/">
      Explore the systems <span aria-hidden="true">↗</span>
    </a>
  </div>
  <a
    class="atlas-teaser-preview"
    href="/map/"
    aria-label="Open the systems atlas"
  >
    <svg
      viewBox="0 0 540 200"
      role="img"
      aria-label="Regions of the systems atlas"
    >
      {
        connections.map(({ from, to, conceptual }) => (
          <path
            class:list={{ "atlas-teaser-conceptual": conceptual }}
            d={`M ${from.x} ${from.y} C ${from.x} ${(from.y + to.y) / 2}, ${to.x} ${(from.y + to.y) / 2}, ${to.x} ${to.y}`}
          />
        ))
      }
      {
        regions.map((region) => (
          <g>
            <rect
              x={region.x - 76}
              y={region.y - 25}
              width="152"
              height="50"
              rx="3"
            />
            <circle cx={region.x - 61} cy={region.y} r="3" />
            <text x={region.x + 4} y={region.y + 4} text-anchor="middle">
              {region.title}
            </text>
          </g>
        ))
      }
    </svg>
  </a>
</section>

<style>
  .atlas-teaser {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    align-items: center;
    gap: 2rem;
    margin-block: 3rem;
    padding: 2rem 0;
    border-block: 1px solid var(--line-strong);
  }

  .atlas-teaser h2 {
    margin: 0.4rem 0 0.8rem;
    font-family: var(--font-title);
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    font-weight: 450;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .atlas-teaser h2 a {
    text-decoration: none;
  }

  .atlas-teaser-copy > p:not(.eyebrow) {
    max-width: 29rem;
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.5;
  }

  .atlas-teaser-link {
    display: inline-block;
    margin-top: 1rem;
    padding-block: 0.4rem;
    font-family: var(--font-display);
    font-size: 0.88rem;
    color: var(--accent);
  }

  .atlas-teaser-preview {
    display: block;
  }

  .atlas-teaser-preview svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .atlas-teaser-preview path {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1.3;
  }

  .atlas-teaser-preview path.atlas-teaser-conceptual {
    stroke: var(--warm);
    stroke-dasharray: 3 4;
  }

  .atlas-teaser-preview rect {
    fill: var(--bg-strong);
    stroke: var(--line);
  }

  .atlas-teaser-preview circle {
    fill: var(--accent);
  }

  .atlas-teaser-preview text {
    fill: var(--text);
    font-family: var(--font-display);
    font-size: 12px;
  }

  .atlas-teaser-compact {
    margin-block: 0 2.5rem;
  }

  @media (max-width: 900px) {
    .atlas-teaser {
      grid-template-columns: 1fr;
      gap: 1.2rem;
    }

    .atlas-teaser-preview {
      max-width: 38rem;
    }
  }

  @media (max-width: 580px) {
    .atlas-teaser-preview {
      display: none;
    }
  }
</style>
