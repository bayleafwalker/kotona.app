---
import trace from "../data/exhibits/decimal-iron-replay.json";
import {
  projectReplay,
  replayScenarios,
} from "../lib/exhibits/decimal-iron-replay.js";

const choices = replayScenarios();
const initial = projectReplay(trace, choices[0].id);
// The rail shows the whole recorded run at once: which step is displayed,
// which one is the scenario's key checkpoint, and where the beacon is lit.
// Every mark is read from the same projection the readout uses.
const initialRail = initial.steps.map((step) => ({
  id: step.id,
  beaconOn: projectReplay(trace, choices[0].id, step.id).beaconOn,
}));
const isNonZero = (difference: string) => !/^0\b/.test(difference);
---

<section
  id="exhibit"
  class="decimal-replay exhibit"
  data-decimal-replay
  aria-label="Decimal Iron recorded replay"
>
  <p class="replay-scope exhibit-kicker">
    Recorded Python reference trace · synthetic business days
  </p>
  <div class="replay-controls">
    <label>
      <span>Era and scenario</span>
      <select data-replay-scenario>
        {
          choices.map((choice) => (
            <option value={choice.id}>{choice.title}</option>
          ))
        }
      </select>
    </label>
    <label>
      <span>Recorded step</span>
      <select data-replay-step>
        {
          initial.steps.map((step, index) => (
            <option value={step.id} selected={step.id === initial.stepId}>
              {index + 1}. {step.label}
            </option>
          ))
        }
      </select>
    </label>
  </div>
  <div class="step-buttons">
    <button type="button" data-replay-previous>
      <span aria-hidden="true">←</span> Previous step
    </button>
    <button type="button" data-replay-next>
      Next step <span aria-hidden="true">→</span>
    </button>
    <button type="button" class="checkpoint-button" data-replay-interrupt>
      Go to key checkpoint
    </button>
  </div>
  {
    /* A sighted shortcut over the same steps the select and buttons reach,
       so it is hidden from assistive technology rather than duplicated. */
  }
  <div class="rail" aria-hidden="true">
    <ol class="rail-steps" data-replay-rail>
      {
        initialRail.map((step) => (
          <li
            data-rail-step={step.id}
            data-beacon={String(step.beaconOn)}
            data-key={String(step.id === initial.stepId)}
            data-current={String(step.id === initial.stepId)}
          />
        ))
      }
    </ol>
    <p class="rail-legend">
      <span class="legend-current">Shown step</span>
      <span class="legend-key">Key checkpoint</span>
      <span class="legend-beacon">Beacon lit</span>
      <span class="legend-changed">Changed since the last step shown</span>
    </p>
  </div>
  <div class="replay-current" aria-live="polite" aria-atomic="true">
    <div class="replay-head">
      <div>
        <p class="step-number" data-replay-counter>
          Step {initial.stepIndex + 1} of {initial.stepCount}
        </p>
        <h3 data-replay-label>{initial.stepLabel}</h3>
      </div>
      <div class="beacon" data-replay-beacon data-on={String(initial.beaconOn)}>
        <span class="lamp" aria-hidden="true"></span>
        <span data-replay-beacon-label
          >Beacon {initial.beaconOn ? "ON" : "OFF"}</span
        >
      </div>
    </div>
    <dl class="machine-state">
      <dt>Client acknowledgement</dt><dd data-replay-ack>
        {initial.acknowledgement}
      </dd>
      <dt>Processor transaction count</dt><dd data-replay-count>
        {initial.transactionCount}
      </dd>
      <dt>Synthetic business date</dt><dd data-replay-date>
        {initial.businessDate}
      </dd>
      <dt>Machine phase / key</dt><dd data-replay-phase>
        {initial.phase} / {initial.keyPosition}
      </dd>
    </dl>
  </div>
  <div class="terminal">
    <p class="terminal-label">Recorded action</p>
    <p data-replay-action>{initial.action}</p>
    <p class="terminal-label">Terminal result</p>
    <pre data-replay-terminal>{initial.terminal}</pre>
  </div>
  <table class="scope-table">
    <caption>Independent reconciliation scopes</caption>
    <thead
      ><tr><th>Scope</th><th>Recorded status</th><th>Difference</th></tr></thead
    >
    <tbody>
      {
        initial.scopes.map((scope) => (
          <tr data-replay-currency={scope.currency}>
            <th scope="row">
              {scope.currency} · {scope.unit}
            </th>
            <td data-scope-status>{scope.status}</td>
            <td
              data-scope-difference
              data-nonzero={String(isNonZero(scope.difference))}
            >
              {scope.difference}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
  <p class="beacon-note">
    The beacon lights when a reconciliation finds a difference, and stays lit
    until a fresh reconciliation finds none.
  </p>
  <div
    class="conversion"
    data-replay-conversion
    hidden={initial.conversion === null}
  >
    <h4>Recorded EUR conversion statement</h4>
    <dl>
      <dt>Source items</dt><dd data-conversion-source>
        {initial.conversion?.sourceItems}
      </dd>
      <dt>Individually rounded items</dt><dd data-conversion-items>
        {initial.conversion?.convertedItems}
      </dd>
      <dt>Sum of rounded items</dt><dd data-conversion-total>
        {initial.conversion?.itemTotal}
      </dd>
      <dt>Rounded aggregate</dt><dd data-conversion-aggregate>
        {initial.conversion?.aggregateTotal}
      </dd>
      <dt>Declared adjustment</dt><dd data-conversion-adjustment>
        {initial.conversion?.adjustment}
      </dd>
      <dt>Rate</dt><dd data-conversion-rate>{initial.conversion?.rate}</dd>
      <dt>Rounding policy</dt><dd data-conversion-policy>
        {initial.conversion?.policy}
      </dd>
    </dl>
  </div>
  <details>
    <summary>Inspect recorded positions and journal</summary>
    <p>Participant positions remain in FIM penni.</p>
    <pre data-replay-positions>{initial.positions}</pre>
    <p class="journal" data-replay-journal>{initial.journal}</p>
    <p data-replay-checks>
      {initial.checkCount} fixture assertions passed at this recorded step.
    </p>
  </details>
  <p class="replay-scope">
    Navigation selects recorded states. The physical installation, RTL scenario
    adapter and KESKUS game were not exercised by this trace.
  </p>
  <noscript
    ><p>
      The commit-before-acknowledgement checkpoint is shown. JavaScript enables
      step selection.
    </p></noscript
  >
</section>

<script>
  import trace from "../data/exhibits/decimal-iron-replay.json";
  import { projectReplay } from "../lib/exhibits/decimal-iron-replay.js";
  import { writeMarked } from "../lib/exhibit-marks.js";

  for (const root of document.querySelectorAll<HTMLElement>(
    "[data-decimal-replay]",
  )) {
    const scenario = root.querySelector<HTMLSelectElement>(
      "[data-replay-scenario]",
    );
    const step = root.querySelector<HTMLSelectElement>("[data-replay-step]");
    const previous = root.querySelector<HTMLButtonElement>(
      "[data-replay-previous]",
    );
    const next = root.querySelector<HTMLButtonElement>("[data-replay-next]");
    const interrupt = root.querySelector<HTMLButtonElement>(
      "[data-replay-interrupt]",
    );
    if (!scenario || !step || !previous || !next || !interrupt) continue;
    const rail = root.querySelector<HTMLElement>("[data-replay-rail]");
    let current = projectReplay(trace, scenario.value);
    // Values are marked only when the reader moves between steps of one
    // scenario. On first paint and on a scenario switch everything differs.
    let marking = false;
    const setText = (selector: string, value: string) => {
      const target = root.querySelector<HTMLElement>(selector);
      if (!target) throw new Error(`Missing replay projection: ${selector}`);
      writeMarked(target, value, marking);
    };
    const buildRail = () => {
      if (!rail) return;
      const keyStepId = projectReplay(trace, scenario.value).stepId;
      rail.replaceChildren(
        ...current.steps.map((entry) => {
          const item = document.createElement("li");
          item.dataset.railStep = entry.id;
          item.dataset.beacon = String(
            projectReplay(trace, scenario.value, entry.id).beaconOn,
          );
          item.dataset.key = String(entry.id === keyStepId);
          return item;
        }),
      );
    };
    const render = (rebuildSteps = false) => {
      marking = root.dataset.initialized === "true" && !rebuildSteps;
      if (rebuildSteps) {
        buildRail();
        step.replaceChildren(
          ...current.steps.map((entry, index) => {
            const option = document.createElement("option");
            option.value = entry.id;
            option.textContent = `${index + 1}. ${entry.label}`;
            return option;
          }),
        );
      }
      step.value = current.stepId;
      root.dataset.step = current.stepId;
      for (const item of rail?.children ?? []) {
        if (item instanceof HTMLElement) {
          item.dataset.current = String(
            item.dataset.railStep === current.stepId,
          );
        }
      }
      previous.disabled = current.stepIndex === 0;
      next.disabled = current.stepIndex === current.stepCount - 1;
      // The counter and title change on every move, so they are never marked.
      const wasMarking = marking;
      marking = false;
      setText(
        "[data-replay-counter]",
        `Step ${current.stepIndex + 1} of ${current.stepCount}`,
      );
      setText("[data-replay-label]", current.stepLabel);
      marking = wasMarking;
      const beacon = root.querySelector<HTMLElement>("[data-replay-beacon]");
      if (beacon) beacon.dataset.on = String(current.beaconOn);
      setText(
        "[data-replay-beacon-label]",
        `Beacon ${current.beaconOn ? "ON" : "OFF"}`,
      );
      setText("[data-replay-ack]", current.acknowledgement);
      setText("[data-replay-count]", String(current.transactionCount));
      setText("[data-replay-date]", current.businessDate);
      setText(
        "[data-replay-phase]",
        `${current.phase} / ${current.keyPosition}`,
      );
      setText("[data-replay-action]", current.action);
      setText("[data-replay-terminal]", current.terminal);
      setText("[data-replay-positions]", current.positions);
      setText("[data-replay-journal]", current.journal);
      setText(
        "[data-replay-checks]",
        `${current.checkCount} fixture assertions passed at this recorded step.`,
      );
      for (const scope of current.scopes) {
        const selector = `[data-replay-currency="${scope.currency}"]`;
        setText(`${selector} [data-scope-status]`, scope.status);
        setText(`${selector} [data-scope-difference]`, scope.difference);
        const difference = root.querySelector<HTMLElement>(
          `${selector} [data-scope-difference]`,
        );
        if (difference) {
          difference.dataset.nonzero = String(!/^0\b/.test(scope.difference));
        }
      }
      const conversion = root.querySelector<HTMLElement>(
        "[data-replay-conversion]",
      );
      if (conversion) conversion.hidden = current.conversion === null;
      if (current.conversion) {
        setText("[data-conversion-source]", current.conversion.sourceItems);
        setText("[data-conversion-items]", current.conversion.convertedItems);
        setText("[data-conversion-total]", current.conversion.itemTotal);
        setText(
          "[data-conversion-aggregate]",
          current.conversion.aggregateTotal,
        );
        setText("[data-conversion-adjustment]", current.conversion.adjustment);
        setText("[data-conversion-rate]", current.conversion.rate);
        setText("[data-conversion-policy]", current.conversion.policy);
      }
    };
    scenario.addEventListener("change", () => {
      current = projectReplay(trace, scenario.value);
      render(true);
    });
    step.addEventListener("change", () => {
      current = projectReplay(trace, scenario.value, step.value);
      render();
    });
    for (const [button, delta] of [
      [previous, -1],
      [next, 1],
    ] as const) {
      button.addEventListener("click", () => {
        const target = current.steps[current.stepIndex + delta];
        if (target) {
          current = projectReplay(trace, scenario.value, target.id);
          render();
        }
      });
    }
    rail?.addEventListener("click", (event) => {
      const item =
        event.target instanceof Element
          ? event.target.closest<HTMLElement>("[data-rail-step]")
          : null;
      if (item?.dataset.railStep) {
        current = projectReplay(trace, scenario.value, item.dataset.railStep);
        render();
      }
    });
    interrupt.addEventListener("click", () => {
      current = projectReplay(trace, scenario.value);
      render();
    });
    render();
    root.dataset.initialized = "true";
  }
</script>

<style>
  .replay-controls {
    display: grid;
    gap: 0.8rem;
  }
  .replay-controls label {
    display: grid;
    min-width: 0;
    gap: 0.3rem;
  }
  .replay-controls select {
    width: 100%;
  }
  .step-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0.8rem 1rem;
  }
  .checkpoint-button {
    margin-inline-start: auto;
  }
  .rail {
    margin-block: 0 1rem;
  }
  .rail-steps {
    display: flex;
    gap: 3px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rail-steps :global(li) {
    position: relative;
    flex: 1 1 0;
    height: 1.5rem;
    margin: 0;
    border-bottom: 4px solid var(--line-strong);
    cursor: pointer;
  }
  .rail-steps :global(li):hover {
    border-bottom-color: var(--muted);
  }
  .rail-steps :global(li)[data-beacon="true"] {
    border-bottom-color: var(--warm);
  }
  .rail-steps :global(li)[data-current="true"]::before {
    position: absolute;
    inset: auto 0 2px;
    height: 0.5rem;
    background: var(--text);
    content: "";
  }
  .rail-steps :global(li)[data-key="true"]::after {
    position: absolute;
    top: 0.05rem;
    left: 50%;
    width: 0.42rem;
    height: 0.42rem;
    border: 1.5px solid var(--accent);
    background: var(--bg-strong);
    content: "";
    transform: translateX(-50%) rotate(45deg);
  }
  .rail-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1.1rem;
    margin: 0.55rem 0 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    line-height: 1.5;
  }
  .rail-legend span::before {
    display: inline-block;
    width: 0.6rem;
    height: 0.6rem;
    margin-right: 0.4rem;
    vertical-align: -0.05rem;
    content: "";
  }
  .legend-current::before {
    background: var(--text);
  }
  .legend-key::before {
    border: 1.5px solid var(--accent);
    transform: scale(0.75) rotate(45deg);
  }
  .legend-beacon::before {
    height: 4px !important;
    background: var(--warm);
    vertical-align: 0.1rem !important;
  }
  .legend-changed::before {
    background: color-mix(in srgb, var(--accent) 24%, transparent);
  }
  .replay-current {
    border-block: 1px solid var(--line);
    padding-block: 0.9rem 0.75rem;
  }
  .replay-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.6rem 1.25rem;
  }
  .replay-head > div:first-child {
    flex: 1 1 16rem;
    min-width: 0;
  }
  .replay-current h3 {
    margin: 0.25rem 0 0;
    font-size: 1.3rem;
    font-weight: 500;
    line-height: 1.2;
  }
  .step-number {
    margin: 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }
  .beacon {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
  }
  .lamp {
    width: 0.7rem;
    height: 0.7rem;
    flex: none;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: var(--line);
  }
  .beacon[data-on="true"] {
    border-color: var(--warm);
    background: var(--warm);
    color: var(--bg-strong);
  }
  .beacon[data-on="true"] .lamp {
    border-color: var(--bg-strong);
    background: var(--bg-strong);
  }
  .machine-state,
  .conversion dl {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 0.4rem 0.75rem;
    margin-block: 0.9rem 0.25rem;
    font-size: 0.95rem;
    line-height: 1.4;
  }
  dt {
    color: var(--muted);
  }
  dd {
    margin: 0;
    justify-self: start;
    overflow-wrap: anywhere;
  }
  .terminal {
    margin-block: 1rem;
    border-inline-start: 3px solid var(--accent);
    padding-inline-start: 0.9rem;
  }
  .terminal p,
  .terminal pre {
    width: fit-content;
    margin-block: 0.25rem 0.7rem;
    overflow-wrap: anywhere;
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }
  .terminal .terminal-label {
    margin-block: 0 0.2rem;
    color: var(--muted);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .terminal pre {
    justify-self: start;
    margin-bottom: 0;
    padding: 0.55rem 0.75rem;
  }
  pre {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    max-width: 100%;
    margin-block: 0.4rem;
    font-size: 0.82rem;
  }
  .scope-table {
    display: table;
    width: 100%;
    max-width: 100%;
    table-layout: fixed;
    overflow: visible;
    font-size: 0.92rem;
  }
  .scope-table th,
  .scope-table td {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .scope-table [data-nonzero="true"] {
    color: var(--warm);
    font-weight: 600;
  }
  caption {
    text-align: left;
    margin-bottom: 0.4rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .beacon-note {
    margin: 0.7rem 0 0;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.45;
  }
  .conversion {
    border: 1px solid var(--line);
    margin-block: 1rem;
    padding: 0.85rem 1rem;
  }
  .conversion h4 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 500;
  }
  .journal {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    overflow-wrap: anywhere;
  }
  details {
    margin-top: 1rem;
    font-size: 0.92rem;
  }
  summary {
    cursor: pointer;
  }
  .replay-scope:last-of-type {
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.5;
  }
  @media (max-width: 420px) {
    .machine-state,
    .conversion dl {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.1rem;
    }
    dd {
      margin-bottom: 0.5rem;
    }
    .step-buttons button {
      flex-grow: 1;
    }
    .legend-changed {
      flex-basis: 100%;
    }
  }
</style>
