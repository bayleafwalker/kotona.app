---
import type { KnowledgeGraph } from "../lib/knowledge-map";
import type { ReferenceSearchDocument } from "../lib/reference-ranking.js";

type Props = {
  graph: KnowledgeGraph;
  searchDocuments: ReferenceSearchDocument[];
};
const { graph, searchDocuments } = Astro.props;
const nodesById = new Map(graph.nodes.map((node) => [node.id, node]));
const clusterCentres = new Map<string, { x: number; y: number }>(
  graph.clusters.map((cluster) => {
    const nodes = graph.nodes.filter((node) => node.cluster === cluster.id);
    return [
      cluster.id,
      {
        x: nodes.reduce((sum, node) => sum + node.x, 0) / nodes.length,
        y: nodes.reduce((sum, node) => sum + node.y, 0) / nodes.length,
      },
    ] as const;
  }),
);
const projectMapLabels: Record<string, string> = {
  vuoro: "Vuoro",
  "contract-first-box": "Box",
  "gitops-cluster": "Appservice",
  "household-operating-platform": "Homelab Analytics",
};
const clusterLabelYOverrides: Record<string, number> = {
  // Keep this heading clear of the northern-most agent-system node. The other
  // territories retain their calculated labels because their node rings leave
  // the same space naturally.
  "agents-assurance": 12, // labelY coordinate
};
const labelLines = (label: string, maxLength = 28) => {
  const words = label.split(" ");
  const lines: string[] = [];
  let line = "";
  for (const word of words) {
    const next = line ? `${line} ${word}` : word;
    if (line && next.length > maxLength) {
      lines.push(line);
      line = word;
    } else {
      line = next;
    }
  }
  if (line) lines.push(line);
  return lines.slice(0, 3);
};
const nodeLabel = (node: (typeof graph.nodes)[number]) => {
  const cluster = clusterCentres.get(node.cluster);
  const label =
    node.type === "project"
      ? (projectMapLabels[node.id] ?? node.title)
      : node.title;
  const lines = labelLines(label, node.type === "project" ? 20 : 30);
  const deltaX = node.x - (cluster?.x ?? 500);
  const deltaY = node.y - (cluster?.y ?? 310);
  const goesLeft = Math.abs(deltaX) >= Math.abs(deltaY) && deltaX < 0;
  const goesRight = Math.abs(deltaX) >= Math.abs(deltaY) && deltaX >= 0;
  const goesUp = !goesLeft && !goesRight && deltaY < 0;
  return {
    lines,
    x: node.x + (goesLeft ? -12 : goesRight ? 12 : 0),
    y: node.y + (goesUp ? -12 : 18),
    anchor: goesLeft ? "end" : goesRight ? "start" : "middle",
  };
};
const edgeCoordinates = (
  source: (typeof graph.nodes)[number],
  target: (typeof graph.nodes)[number],
  directed: boolean,
) => {
  if (!directed)
    return { x1: source.x, y1: source.y, x2: target.x, y2: target.y };
  const deltaX = target.x - source.x;
  const deltaY = target.y - source.y;
  const distance = Math.hypot(deltaX, deltaY);
  if (distance === 0)
    return { x1: source.x, y1: source.y, x2: target.x, y2: target.y };
  const sourceInset = source.type === "project" ? 10 : 8;
  // Leave space for both the target's shape and the arrow marker tip.
  const targetInset = target.type === "project" ? 14 : 12;
  return {
    x1: source.x + (deltaX / distance) * sourceInset,
    y1: source.y + (deltaY / distance) * sourceInset,
    x2: target.x - (deltaX / distance) * targetInset,
    y2: target.y - (deltaY / distance) * targetInset,
  };
};
const clusterNodes = graph.clusters.map((cluster) => ({
  ...cluster,
  current: graph.nodes.filter(
    (node) => node.cluster === cluster.id && node.lifecycle === "current",
  ),
  historical: graph.nodes.filter(
    (node) => node.cluster === cluster.id && node.lifecycle !== "current",
  ),
}));
---

<section class="knowledge-explorer" data-knowledge-explorer>
  <script
    type="application/json"
    data-knowledge-search-index
    set:html={JSON.stringify(searchDocuments)}
  />
  <form class="knowledge-controls" aria-label="Filter the knowledge atlas">
    <label class="knowledge-search">
      <span>Search or ask a question</span>
      <input type="search" name="knowledge-search" autocomplete="off" />
    </label>
    <fieldset>
      <legend>Show</legend>
      <label
        ><input type="checkbox" name="type" value="note" checked /> Notes</label
      >
      <label
        ><input type="checkbox" name="type" value="project" checked /> Projects</label
      >
      <label><input type="checkbox" name="history" /> Historical notes</label>
    </fieldset>
    <p class="knowledge-result-count" aria-live="polite"></p>
  </form>

  <section class="knowledge-results" data-knowledge-results hidden>
    <h2>Ranked results</h2>
    <p class="knowledge-results-note">
      Ranked by curated reference scope, title, summary, and tags. Current
      material leads unless the question asks about the past. The grouped index
      below stays complete.
    </p>
    <ol data-knowledge-results-list></ol>
  </section>

  <div class="knowledge-map-stage">
    <div class="knowledge-map-frame" aria-label="Visual knowledge map">
      <svg
        class="knowledge-map"
        viewBox="0 0 1000 620"
        aria-label="Knowledge atlas for published notes and projects"
        aria-describedby="knowledge-map-desc"
      >
        <desc id="knowledge-map-desc"
          >Six editorial clusters connected only by explicitly published
          relationships. The grouped index following the map contains the same
          entries.</desc
        >
        <defs>
          <marker
            id="knowledge-arrow"
            viewBox="0 0 10 10"
            refX="8"
            refY="5"
            markerWidth="5"
            markerHeight="5"
            orient="auto-start-reverse"
          >
            <path d="M 0 0 L 10 5 L 0 10 z"></path>
          </marker>
        </defs>
        {
          graph.clusters.map((cluster) => {
            const clusterConfig = graph.nodes.filter(
              (node) => node.cluster === cluster.id,
            );
            const x =
              clusterConfig.reduce((sum, node) => sum + node.x, 0) /
              clusterConfig.length;
            const y =
              clusterConfig.reduce((sum, node) => sum + node.y, 0) /
              clusterConfig.length;
            const lines = labelLines(cluster.label, 31);
            const labelY =
              clusterLabelYOverrides[cluster.id] ?? Math.max(20, y - 95);
            return (
              <g
                class="knowledge-cluster-control"
                role="button"
                tabindex="0"
                aria-label={`Highlight ${cluster.label}`}
                aria-pressed="false"
                data-cluster-id={cluster.id}
              >
                <text
                  class="knowledge-cluster-label"
                  x={x}
                  y={labelY}
                  text-anchor="middle"
                >
                  {lines.map((line, index) => (
                    <tspan x={x} dy={index === 0 ? 0 : 15}>
                      {line}
                    </tspan>
                  ))}
                </text>
              </g>
            );
          })
        }
        <g class="knowledge-edges" aria-hidden="true">
          {
            graph.edges.map((edge) => {
              const source = nodesById.get(edge.source);
              const target = nodesById.get(edge.target);
              if (!source || !target) return null;
              const historical =
                source.lifecycle !== "current" ||
                target.lifecycle !== "current";
              const succession =
                edge.type === "superseded-by" ||
                edge.type === "invalidated-by-project";
              const line = edgeCoordinates(source, target, succession);
              return (
                <line
                  x1={line.x1}
                  y1={line.y1}
                  x2={line.x2}
                  y2={line.y2}
                  class:list={{
                    "knowledge-edge": true,
                    "is-historical": historical,
                    "is-cross-territory": source.cluster !== target.cluster,
                  }}
                  data-source={source.id}
                  data-target={target.id}
                  data-source-cluster={source.cluster}
                  data-target-cluster={target.cluster}
                  data-edge-type={edge.type}
                  marker-end={succession ? "url(#knowledge-arrow)" : undefined}
                />
              );
            })
          }
        </g>
        <g class="knowledge-nodes">
          {
            graph.nodes.map((node) => (
              <a
                href={node.href}
                aria-label={`${node.title}. ${node.type === "project" ? "Project" : "Note"}. ${node.summary}`}
                class:list={{
                  "knowledge-node": true,
                  "is-project": node.type === "project",
                  "is-anchor": node.anchor,
                  "is-historical": node.lifecycle !== "current",
                }}
                data-node-id={node.id}
                data-node-type={node.type}
                data-cluster={node.cluster}
                data-title={node.title}
                data-summary={node.summary}
                data-area={node.type === "project" ? "Project" : node.area}
                data-node-x={node.x}
                aria-controls="knowledge-detail"
                aria-expanded="false"
                data-search={`${node.title} ${node.summary} ${node.area ?? ""} ${node.tags.join(" ")}`.toLowerCase()}
              >
                {node.type === "project" ? (
                  <rect
                    x={node.x - 8}
                    y={node.y - 8}
                    width="16"
                    height="16"
                    rx="3"
                  />
                ) : (
                  <circle cx={node.x} cy={node.y} r={node.anchor ? 8 : 6} />
                )}
                {(() => {
                  const label = nodeLabel(node);
                  return (
                    <text
                      class:list={{
                        "knowledge-node-label": true,
                        "is-persistent": node.type === "project",
                      }}
                      x={label.x}
                      y={label.y - (label.lines.length - 1) * 6}
                      text-anchor={label.anchor}
                    >
                      {label.lines.map((line, index) => (
                        <tspan x={label.x} dy={index === 0 ? 0 : 12}>
                          {line}
                        </tspan>
                      ))}
                    </text>
                  );
                })()}
              </a>
            ))
          }
        </g>
      </svg>
    </div>
    <aside
      id="knowledge-detail"
      class="knowledge-detail"
      data-knowledge-detail
      hidden
      role="region"
      aria-labelledby="knowledge-detail-title"
    >
      <p class="knowledge-detail-kicker" data-detail-kind></p>
      <h2 id="knowledge-detail-title" data-detail-title tabindex="-1"></h2>
      <p data-detail-summary></p>
      <div class="knowledge-detail-related" data-detail-superseded hidden>
        <h3>Superseded by</h3>
        <ul data-detail-superseded-list></ul>
      </div>
      <div class="knowledge-detail-related" data-detail-invalidated hidden>
        <h3>Invalidated by project</h3>
        <ul data-detail-invalidated-list></ul>
      </div>
      <div class="knowledge-detail-related" data-detail-related hidden>
        <h3>Related</h3>
        <ul data-detail-related-list></ul>
      </div>
      <a data-detail-link>Open note →</a>
      <button type="button" class="knowledge-detail-close" data-detail-close>
        Close
      </button>
    </aside>
  </div>

  <p class="knowledge-map-hint">
    Hover to identify, pause to preview · click to keep the inspector open
  </p>
  <ul class="knowledge-legend" aria-label="Knowledge map legend">
    <li><span class="legend-note" aria-hidden="true"></span>Note</li>
    <li><span class="legend-project" aria-hidden="true"></span>Project</li>
    <li>
      <span class="legend-relation" aria-hidden="true"></span>Declared relation
      or project membership
    </li>
    <li>
      <span class="legend-succession" aria-hidden="true"></span>Succession or
      invalidation
    </li>
    <li>
      <span class="legend-historical" aria-hidden="true"></span>Historical
    </li>
  </ul>

  <div class="knowledge-index" aria-labelledby="knowledge-index-title">
    <div class="section-heading">
      <h2 id="knowledge-index-title">Grouped index</h2>
      <a href="/notes/">Chronological notes</a>
    </div>
    <p class="page-copy">
      The index is the complete text alternative to the map and remains useful
      without JavaScript.
    </p>
    <div class="knowledge-clusters">
      {
        clusterNodes.map((cluster) => (
          <section class="knowledge-cluster" data-cluster={cluster.id}>
            <h3>{cluster.label}</h3>
            <p>{cluster.summary}</p>
            <ul>
              {cluster.current.map((node) => (
                <li
                  data-index-id={node.id}
                  data-node-type={node.type}
                  data-search={`${node.title} ${node.summary} ${node.area ?? ""} ${node.tags.join(" ")}`.toLowerCase()}
                >
                  <a href={node.href}>{node.title}</a>
                  <span>{node.type === "project" ? "Project" : node.area}</span>
                  {node.summary ? <p>{node.summary}</p> : null}
                </li>
              ))}
            </ul>
            {cluster.historical.length > 0 ? (
              <details class="knowledge-history">
                <summary>
                  Historical notes ({cluster.historical.length})
                </summary>
                <ul>
                  {cluster.historical.map((node) => (
                    <li
                      data-index-id={node.id}
                      data-node-type={node.type}
                      data-historical
                      data-search={`${node.title} ${node.summary} ${node.tags.join(" ")}`.toLowerCase()}
                    >
                      <a href={node.href}>{node.title}</a>
                      <span>{node.lifecycle}</span>
                    </li>
                  ))}
                </ul>
              </details>
            ) : null}
          </section>
        ))
      }
    </div>
  </div>
</section>

<script>
  import {
    rankReferences,
    type ReferenceSearchDocument,
  } from "../lib/reference-ranking.js";

  const explorer = document.querySelector("[data-knowledge-explorer]");
  if (explorer instanceof HTMLElement) {
    const search = explorer.querySelector('input[name="knowledge-search"]');
    const typeInputs = [...explorer.querySelectorAll('input[name="type"]')];
    const historyInput = explorer.querySelector('input[name="history"]');
    const nodes = [...explorer.querySelectorAll("[data-node-id]")];
    const items = [...explorer.querySelectorAll("[data-index-id]")];
    const edges = [...explorer.querySelectorAll("[data-source][data-target]")];
    const clusterControls = [...explorer.querySelectorAll("[data-cluster-id]")];
    const map = explorer.querySelector(".knowledge-map");
    const count = explorer.querySelector(".knowledge-result-count");
    const resultsRegion = explorer.querySelector("[data-knowledge-results]");
    const resultsList = explorer.querySelector("[data-knowledge-results-list]");
    const searchIndexSource = explorer.querySelector(
      "[data-knowledge-search-index]",
    );
    const searchIndex: ReferenceSearchDocument[] = searchIndexSource
      ? JSON.parse(searchIndexSource.textContent ?? "[]")
      : [];

    // One ranking drives both the ranked list and what the map and index show.
    // A natural-language question used to empty the map, because the filter
    // asked for a contiguous substring that no title contains.
    let lastQuery: string | undefined;
    let lastRanked: ReturnType<typeof rankReferences> = [];
    const rankedFor = (query: string) => {
      if (query !== lastQuery) {
        lastQuery = query;
        lastRanked = rankReferences(searchIndex, query);
      }
      return lastRanked;
    };

    const renderResults = (
      query: string,
      types: Set<string>,
      showHistory: boolean,
    ) => {
      if (!(resultsRegion instanceof HTMLElement)) return;
      if (!(resultsList instanceof HTMLElement)) return;

      if (query.length < 3) {
        resultsRegion.hidden = true;
        resultsList.replaceChildren();
        return;
      }

      // The ranked list obeys the same controls as the map and the index.
      // A result the reader has filtered out must not reappear here.
      const ranked = rankedFor(query)
        .filter(
          (result) =>
            types.has(result.document.type) &&
            (showHistory ||
              !result.document.lifecycle ||
              result.document.lifecycle === "current"),
        )
        .slice(0, 8);
      resultsRegion.hidden = false;
      resultsList.replaceChildren(
        ...ranked.map((result) => {
          const item = document.createElement("li");
          const link = document.createElement("a");
          link.href = result.document.path;
          link.textContent = result.document.title;
          item.appendChild(link);

          const meta = document.createElement("span");
          meta.className = "knowledge-result-meta";
          meta.textContent =
            result.document.type === "project"
              ? "Project"
              : [result.document.area, result.document.lifecycle]
                  .filter(Boolean)
                  .join(" / ");
          item.appendChild(meta);

          if (result.document.summary) {
            const summary = document.createElement("p");
            summary.textContent = result.document.summary;
            item.appendChild(summary);
          }

          // Why this result, in the ranker's own terms. A reader who
          // disagrees with the order can see what produced it.
          const reasons = result.reasons
            .filter((reason) => reason.field !== "tags")
            .slice(0, 2)
            .map((reason) => `${reason.field}: ${reason.value}`);
          if (reasons.length > 0) {
            const why = document.createElement("p");
            why.className = "knowledge-result-why";
            why.textContent = reasons.join(" -- ");
            item.appendChild(why);
          }

          return item;
        }),
      );

      if (ranked.length === 0) {
        const empty = document.createElement("li");
        empty.textContent =
          "No ranked match. The grouped index below is complete.";
        resultsList.appendChild(empty);
      }
    };
    const detail = explorer.querySelector("[data-knowledge-detail]");
    const detailKind = explorer.querySelector("[data-detail-kind]");
    const detailTitle = explorer.querySelector("[data-detail-title]");
    const detailSummary = explorer.querySelector("[data-detail-summary]");
    const detailSuperseded = explorer.querySelector("[data-detail-superseded]");
    const detailSupersededList = explorer.querySelector(
      "[data-detail-superseded-list]",
    );
    const detailInvalidated = explorer.querySelector(
      "[data-detail-invalidated]",
    );
    const detailInvalidatedList = explorer.querySelector(
      "[data-detail-invalidated-list]",
    );
    const detailRelated = explorer.querySelector("[data-detail-related]");
    const detailRelatedList = explorer.querySelector(
      "[data-detail-related-list]",
    );
    const detailLink = explorer.querySelector("[data-detail-link]");
    const detailClose = explorer.querySelector("[data-detail-close]");
    let selectedNodeId: string | undefined;
    let selectedClusterId: string | undefined;
    let selectionOrigin: SVGElement | undefined;
    let selectionWasKeyboard = false;
    let hoveredNode: SVGElement | undefined;
    let hoverPreviewNodeId: string | undefined;
    let hoverTitleTimer: number | undefined;
    let hoverPreviewTimer: number | undefined;
    let hoverCloseTimer: number | undefined;
    let hoverCorridor: { from: DOMRect; to: DOMRect } | undefined;
    const hoverTitleDelay = 200;
    const hoverPreviewDelay = 2000;
    const hoverExitGrace = 300;

    const clearEmphasis = () => {
      explorer.classList.remove("is-identifying", "is-identifying-node");
      nodes.forEach((node) => {
        if (!(node instanceof SVGElement)) return;
        node.classList.remove(
          "is-unrelated",
          "is-selected",
          "is-active",
          "is-label-visible",
        );
        node.setAttribute("aria-expanded", "false");
      });
      edges.forEach((edge) =>
        edge.classList.remove(
          "is-related",
          "is-crossing",
          "is-succession-related",
          "is-unrelated",
        ),
      );
      clusterControls.forEach((control) => {
        control.classList.remove("is-selected");
        control.setAttribute("aria-pressed", "false");
      });
    };

    const emphasizeNode = (id: string, pinned = false) => {
      explorer.classList.toggle("is-identifying", !pinned);
      explorer.classList.toggle("is-identifying-node", !pinned);
      const neighbours = new Set([id]);
      for (const edge of edges) {
        if (!(edge instanceof SVGElement)) continue;
        if (edge.dataset.source === id && edge.dataset.target)
          neighbours.add(edge.dataset.target);
        if (edge.dataset.target === id && edge.dataset.source)
          neighbours.add(edge.dataset.source);
      }
      nodes.forEach((candidate) => {
        if (!(candidate instanceof SVGElement)) return;
        const candidateId = candidate.dataset.nodeId;
        candidate.classList.toggle(
          "is-unrelated",
          !candidateId || !neighbours.has(candidateId),
        );
        candidate.classList.toggle("is-selected", pinned && candidateId === id);
        candidate.classList.toggle(
          "is-active",
          Boolean(candidateId && neighbours.has(candidateId)),
        );
        candidate.classList.toggle(
          "is-label-visible",
          !pinned && candidateId === id,
        );
        candidate.setAttribute(
          "aria-expanded",
          String(pinned && candidateId === id),
        );
      });
      edges.forEach((edge) => {
        if (!(edge instanceof SVGElement)) return;
        const related =
          edge.dataset.source === id || edge.dataset.target === id;
        edge.classList.toggle("is-related", related);
        edge.classList.toggle("is-unrelated", !related);
        edge.classList.toggle(
          "is-succession-related",
          related &&
            (edge.dataset.edgeType === "superseded-by" ||
              edge.dataset.edgeType === "invalidated-by-project"),
        );
      });
    };

    const fillDetailList = (list: Element | null, ids: Set<string>) => {
      if (!(list instanceof HTMLUListElement)) return;
      list.replaceChildren();
      ids.forEach((relatedId) => {
        const related = nodes.find(
          (candidate) =>
            candidate instanceof SVGElement &&
            candidate.dataset.nodeId === relatedId,
        );
        if (!(related instanceof SVGElement)) return;
        const item = document.createElement("li");
        const link = document.createElement("a");
        link.href = related.getAttribute("href") ?? "#";
        link.textContent = related.dataset.title ?? relatedId;
        item.appendChild(link);
        list.appendChild(item);
      });
    };

    const clearHoverTimers = () => {
      if (hoverTitleTimer !== undefined) window.clearTimeout(hoverTitleTimer);
      if (hoverPreviewTimer !== undefined)
        window.clearTimeout(hoverPreviewTimer);
      if (hoverCloseTimer !== undefined) window.clearTimeout(hoverCloseTimer);
      hoverTitleTimer = undefined;
      hoverPreviewTimer = undefined;
      hoverCloseTimer = undefined;
    };

    const clearHoverState = () => {
      clearHoverTimers();
      hoveredNode = undefined;
      hoverCorridor = undefined;
      if (hoverPreviewNodeId && detail instanceof HTMLElement) {
        detail.hidden = true;
        detail.classList.remove("is-hover-preview");
      }
      hoverPreviewNodeId = undefined;
      if (!selectedNodeId && !selectedClusterId) clearEmphasis();
    };

    const closeDetail = (restoreFocus = false) => {
      clearHoverState();
      const origin = selectionOrigin;
      const restore = restoreFocus && selectionWasKeyboard;
      selectedNodeId = undefined;
      selectionOrigin = undefined;
      if (detail instanceof HTMLElement) detail.hidden = true;
      clearEmphasis();
      if (restore) origin?.focus();
      selectionWasKeyboard = false;
    };

    const renderDetail = (node: SVGElement) => {
      if (!(detail instanceof HTMLElement)) return;
      const id = node.dataset.nodeId;
      if (!id) return;
      detail.classList.toggle(
        "is-right-drawer",
        Number(node.dataset.nodeX ?? "500") < 500,
      );
      if (detailKind) detailKind.textContent = node.dataset.area ?? "Note";
      if (detailTitle) detailTitle.textContent = node.dataset.title ?? "";
      if (detailSummary) detailSummary.textContent = node.dataset.summary ?? "";
      if (detailLink instanceof HTMLAnchorElement) {
        detailLink.href = node.getAttribute("href") ?? "#";
        detailLink.textContent = `Open ${node.dataset.nodeType === "project" ? "project" : "note"} →`;
      }
      if (detailRelated instanceof HTMLElement) {
        const relatedIds = new Set<string>();
        const supersedingIds = new Set<string>();
        const invalidatingIds = new Set<string>();
        edges.forEach((edge) => {
          if (!(edge instanceof SVGElement)) return;
          if (edge.dataset.source === id && edge.dataset.target) {
            if (edge.dataset.edgeType === "superseded-by")
              supersedingIds.add(edge.dataset.target);
            else relatedIds.add(edge.dataset.target);
          }
          if (edge.dataset.target === id && edge.dataset.source) {
            if (edge.dataset.edgeType === "invalidated-by-project")
              invalidatingIds.add(edge.dataset.source);
            else relatedIds.add(edge.dataset.source);
          }
        });
        fillDetailList(detailSupersededList, supersedingIds);
        fillDetailList(detailInvalidatedList, invalidatingIds);
        fillDetailList(detailRelatedList, relatedIds);
        if (detailSuperseded instanceof HTMLElement)
          detailSuperseded.hidden = supersedingIds.size === 0;
        if (detailInvalidated instanceof HTMLElement)
          detailInvalidated.hidden = invalidatingIds.size === 0;
        detailRelated.hidden = relatedIds.size === 0;
      }
      detail.hidden = false;
    };

    const showHoverDetail = (node: SVGElement) => {
      if (selectedNodeId || selectedClusterId || hoveredNode !== node) return;
      const id = node.dataset.nodeId;
      if (!id || !(detail instanceof HTMLElement)) return;
      hoverPreviewNodeId = id;
      clearEmphasis();
      emphasizeNode(id);
      detail.classList.add("is-hover-preview");
      renderDetail(node);
      hoverCorridor = {
        from: node.getBoundingClientRect(),
        to: detail.getBoundingClientRect(),
      };
    };

    const showDetail = (node: SVGElement, keyboard = false) => {
      const id = node.dataset.nodeId;
      if (!id) return;
      if (selectedNodeId === id) {
        closeDetail(keyboard);
        return;
      }
      clearHoverState();
      selectedNodeId = id;
      selectedClusterId = undefined;
      selectionOrigin = keyboard ? node : undefined;
      selectionWasKeyboard = keyboard;
      clearEmphasis();
      emphasizeNode(id, true);
      node.setAttribute("aria-expanded", "true");
      if (detail instanceof HTMLElement)
        detail.classList.remove("is-hover-preview");
      renderDetail(node);
      if (keyboard && detailTitle instanceof HTMLElement)
        requestAnimationFrame(() => detailTitle.focus());
    };

    const beginNodeHover = (node: SVGElement) => {
      if (selectedNodeId || selectedClusterId) return;
      clearHoverState();
      hoveredNode = node;
      hoverTitleTimer = window.setTimeout(() => {
        hoverTitleTimer = undefined;
        if (hoveredNode === node && node.dataset.nodeId)
          emphasizeNode(node.dataset.nodeId);
      }, hoverTitleDelay);
      hoverPreviewTimer = window.setTimeout(() => {
        hoverPreviewTimer = undefined;
        showHoverDetail(node);
      }, hoverPreviewDelay);
    };

    const endNodeHover = (node: SVGElement) => {
      if (hoveredNode !== node || selectedNodeId || selectedClusterId) return;
      if (hoverTitleTimer !== undefined) window.clearTimeout(hoverTitleTimer);
      if (hoverPreviewTimer !== undefined)
        window.clearTimeout(hoverPreviewTimer);
      hoverTitleTimer = undefined;
      hoverPreviewTimer = undefined;
      if (!hoverPreviewNodeId) {
        clearHoverState();
        return;
      }
      hoverCloseTimer = window.setTimeout(clearHoverState, hoverExitGrace);
    };

    const isPointerInHoverCorridor = (event: PointerEvent) => {
      if (
        !(hoveredNode instanceof SVGElement) ||
        !(detail instanceof HTMLElement)
      )
        return false;
      const from = hoveredNode.getBoundingClientRect();
      const to = detail.getBoundingClientRect();
      hoverCorridor = { from, to };
      const { from: corridorStart, to: corridorEnd } = hoverCorridor;
      const { clientX: x, clientY: y } = event;
      if (
        x >= corridorEnd.left &&
        x <= corridorEnd.right &&
        y >= corridorEnd.top &&
        y <= corridorEnd.bottom
      )
        return true;
      const fromX = corridorStart.left + corridorStart.width / 2;
      const fromY = corridorStart.top + corridorStart.height / 2;
      if (Math.hypot(x - fromX, y - fromY) <= 16) return true;

      // Bridge to the whole drawer-facing edge, rather than a single nearest
      // point: people naturally move diagonally toward a useful part of a
      // long preview.
      const corridorPadding = 36;
      const drawerIsToTheRight = corridorEnd.left > fromX;
      const drawerEdgeX = drawerIsToTheRight
        ? corridorEnd.left - corridorPadding
        : corridorEnd.right + corridorPadding;
      const edgeTop = corridorEnd.top - corridorPadding;
      const edgeBottom = corridorEnd.bottom + corridorPadding;
      const progress = (x - fromX) / (drawerEdgeX - fromX);
      if (progress < 0 || progress > 1) return false;
      const upperY = fromY + (edgeTop - fromY) * progress;
      const lowerY = fromY + (edgeBottom - fromY) * progress;
      return y >= Math.min(upperY, lowerY) && y <= Math.max(upperY, lowerY);
    };

    document.addEventListener("pointermove", (event) => {
      if (!hoverPreviewNodeId || selectedNodeId || selectedClusterId) return;
      if (isPointerInHoverCorridor(event)) {
        if (hoverCloseTimer !== undefined) {
          window.clearTimeout(hoverCloseTimer);
          hoverCloseTimer = undefined;
        }
        return;
      }
      if (hoverCloseTimer === undefined) {
        hoverCloseTimer = window.setTimeout(clearHoverState, hoverExitGrace);
      }
    });

    const refresh = () => {
      const query =
        search instanceof HTMLInputElement
          ? search.value.trim().toLowerCase()
          : "";
      const types = new Set(
        typeInputs
          .filter((input) => input instanceof HTMLInputElement && input.checked)
          .map((input) =>
            input instanceof HTMLInputElement ? input.value : "",
          ),
      );
      const showHistory =
        historyInput instanceof HTMLInputElement && historyInput.checked;
      explorer.classList.toggle("is-showing-history", showHistory);
      explorer.querySelectorAll(".knowledge-history").forEach((details) => {
        if (details instanceof HTMLDetailsElement) details.open = showHistory;
      });
      // Short queries stay substring-based: a two-character fragment is a
      // filter, not a question, and ranking it would be noise.
      const rankedIds =
        query.length >= 3
          ? new Set(rankedFor(query).map((result) => result.document.id))
          : undefined;
      const matchesQuery = (element: SVGElement | HTMLElement, id: string) =>
        !query ||
        (rankedIds
          ? rankedIds.has(id)
          : element.dataset.search?.includes(query));

      const visible = new Set();
      for (const node of nodes) {
        if (!(node instanceof SVGElement)) continue;
        const match =
          types.has(node.dataset.nodeType ?? "") &&
          matchesQuery(node, node.dataset.nodeId ?? "") &&
          (showHistory || !node.classList.contains("is-historical"));
        node.classList.toggle("is-filtered", !match);
        if (match && node.dataset.nodeId) visible.add(node.dataset.nodeId);
      }
      for (const item of items) {
        if (!(item instanceof HTMLElement)) continue;
        const match = visible.has(item.dataset.indexId ?? "");
        item.hidden = !match;
      }
      for (const edge of edges) {
        if (!(edge instanceof SVGElement)) continue;
        edge.classList.toggle(
          "is-filtered",
          !visible.has(edge.dataset.source ?? "") ||
            !visible.has(edge.dataset.target ?? ""),
        );
      }
      if (selectedNodeId && !visible.has(selectedNodeId)) {
        closeDetail();
      }
      if (count) {
        count.textContent =
          query.length >= 3
            ? `${visible.size} of ${rankedFor(query).length} ranked matches shown`
            : `${visible.size} published entries shown`;
      }
      renderResults(query, types, showHistory);
    };

    explorer.addEventListener("input", refresh);
    for (const node of nodes) {
      if (!(node instanceof SVGElement)) continue;
      const identify = () => {
        if (!selectedNodeId && !selectedClusterId && node.dataset.nodeId)
          emphasizeNode(node.dataset.nodeId);
      };
      const clearIdentify = () => {
        if (!selectedNodeId && !selectedClusterId) clearEmphasis();
      };
      node.addEventListener("focus", identify);
      node.addEventListener("blur", clearIdentify);
      node.addEventListener("mouseenter", () => beginNodeHover(node));
      node.addEventListener("mouseleave", () => endNodeHover(node));
      node.addEventListener("click", (event) => {
        event.preventDefault();
        event.stopPropagation();
        showDetail(node);
      });
      node.addEventListener("keydown", (event) => {
        if (event.key === " " || event.key === "Enter") {
          event.preventDefault();
          showDetail(node, true);
        }
      });
    }
    for (const control of clusterControls) {
      if (!(control instanceof SVGElement)) continue;
      const clusterId = control.dataset.clusterId;
      if (!clusterId) continue;
      const emphasizeCluster = (pinned = false) => {
        explorer.classList.add("is-identifying");
        explorer.classList.remove("is-identifying-node");
        nodes.forEach((node) => {
          if (!(node instanceof SVGElement)) return;
          const matches = node.dataset.cluster === clusterId;
          node.classList.toggle("is-unrelated", !matches);
          node.classList.toggle("is-active", matches);
        });
        edges.forEach((edge) => {
          if (!(edge instanceof SVGElement)) return;
          const crossing =
            (edge.dataset.sourceCluster === clusterId) !==
            (edge.dataset.targetCluster === clusterId);
          edge.classList.toggle("is-crossing", crossing);
          edge.classList.toggle("is-related", pinned && crossing);
          edge.classList.toggle("is-unrelated", !crossing);
        });
        control.classList.toggle("is-selected", pinned);
        control.setAttribute("aria-pressed", String(pinned));
      };
      control.addEventListener("mouseenter", () => {
        if (!selectedNodeId && !selectedClusterId) {
          clearHoverState();
          emphasizeCluster();
        }
      });
      control.addEventListener("mouseleave", () => {
        if (!selectedNodeId && !selectedClusterId) clearEmphasis();
      });
      control.addEventListener("focus", () => {
        if (!selectedNodeId && !selectedClusterId) emphasizeCluster();
      });
      control.addEventListener("blur", () => {
        if (!selectedNodeId && !selectedClusterId) clearEmphasis();
      });
      const toggleCluster = () => {
        if (selectedClusterId === clusterId) {
          selectedClusterId = undefined;
          clearEmphasis();
        } else {
          closeDetail();
          selectedClusterId = clusterId;
          clearEmphasis();
          emphasizeCluster(true);
        }
      };
      control.addEventListener("click", (event) => {
        event.stopPropagation();
        toggleCluster();
      });
      control.addEventListener("keydown", (event) => {
        if (event.key === " " || event.key === "Enter") {
          event.preventDefault();
          toggleCluster();
        }
      });
    }
    if (detailClose instanceof HTMLButtonElement) {
      detailClose.addEventListener("click", () => {
        closeDetail(true);
      });
    }
    if (detail instanceof HTMLElement) {
      detail.addEventListener("mouseenter", () => {
        if (!hoverPreviewNodeId || hoverCloseTimer === undefined) return;
        window.clearTimeout(hoverCloseTimer);
        hoverCloseTimer = undefined;
      });
      detail.addEventListener("mouseleave", () => {
        if (!hoverPreviewNodeId) return;
        if (hoverCloseTimer !== undefined) window.clearTimeout(hoverCloseTimer);
        hoverCloseTimer = window.setTimeout(clearHoverState, hoverExitGrace);
      });
    }
    if (map instanceof SVGElement) {
      map.addEventListener("click", (event) => {
        const target = event.target;
        if (
          target instanceof Element &&
          target.closest(".knowledge-node, .knowledge-cluster-control")
        )
          return;
        if (event.target === map) {
          if (selectedNodeId) closeDetail();
          else if (hoverPreviewNodeId) clearHoverState();
          else if (selectedClusterId) {
            selectedClusterId = undefined;
            clearEmphasis();
          }
        }
      });
    }
    explorer.addEventListener("keydown", (event) => {
      if (
        event.key !== "Escape" ||
        (!selectedNodeId && !selectedClusterId && !hoverPreviewNodeId)
      )
        return;
      event.preventDefault();
      if (selectedNodeId) closeDetail(true);
      else if (hoverPreviewNodeId) clearHoverState();
      else {
        selectedClusterId = undefined;
        clearEmphasis();
      }
    });
    refresh();
  }
</script>
